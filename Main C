#include "meu_banco.h"

/* Menu com as operacoes que ficam dentro da opcao 4. */
void menuOutros(Banco *banco) {
    int opcao;

    do {
        printf("\n========== OUTROS SERVICOS ==========\n");
        printf("1 - Depositar\n");
        printf("2 - Sacar\n");
        printf("3 - Solicitar emprestimo\n");
        printf("4 - Historico do banco\n");
        printf("5 - Relatorios\n");
        printf("6 - Sorteio Fibonacci\n");
        printf("0 - Voltar\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1: depositar(banco); break;
            case 2: sacar(banco); break;
            case 3: solicitarEmprestimo(banco); break;
            case 4: consultarHistorico(banco); break;
            case 5: mostrarRelatorios(banco); break;
            case 6: realizarSorteio(banco); break;
            case 0: break;
            default: printf("Opcao invalida.\n");
        }
    } while (opcao != 0);
}

int main(void) {
    Banco banco;
    char opcao;

    srand((unsigned int)time(NULL));
    inicializarBanco(&banco);

    do {
        printf("\n========== BANCO DIGITAL ==========\n");
        printf("Banco: %s\n", banco.aberto ? "ABERTO" : "FECHADO");
        printf("1 - Abrir banco\n");
        printf("2 - Fechar banco\n");
        printf("3 - Cadastrar cliente\n");
        printf("4 - Outros\n");
        printf("5 - Sair\n");
        printf("Opcao: ");
        scanf(" %c", &opcao);

        switch (opcao) {
            case '1': abrirBanco(&banco); break;
            case '2': fecharBanco(&banco); break;
            case '3': cadastrarCliente(&banco); break;
            case '4': menuOutros(&banco); break;
            case '5':
            case 's':
            case 'S':
                salvarBanco(&banco);
                printf("Banco encerrado.\n");
                break;
            default: printf("Opcao invalida.\n");
        }
    } while (opcao != '5' && opcao != 's' && opcao != 'S');

    liberarBanco(&banco);
    return 0;
}
